# Copy to .env and fill in. Never commit .env.

# Anthropic API key from the Junction partner credits (engine lane; set a spending limit).
ANTHROPIC_API_KEY=

# Absolute path of your clone of miska-voutilainen/junction26-messagepack-csharp (pnpm seed creates it).
SAMPLE_REPO_DIR=

# record: call the model and save each response to data/recordings/ (default)
# replay: read data/recordings/ only, fail on a miss
# live:   call the model without saving
AI_MODE=record

# Temporary access gate until the submission on Sun 15.11 (src/features/access-gate/README.md).
# Empty = gate off. The real code is set in Vercel's env settings only, never here.
ACCESS_CODE=
