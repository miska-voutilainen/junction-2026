# Copy to .env and fill in. Never commit .env.

# claude-code: record through Claude Code's headless mode on your own subscription (default)
# api:         call the Anthropic API with ANTHROPIC_API_KEY
AI_BACKEND=claude-code

# kimi:        call Kimi K3.1 Pro on Verda Inference with KIMI_API_KEY
# Anthropic API key, only for AI_BACKEND=api (set a spending limit).
ANTHROPIC_API_KEY=

# Verda inference key (not a Verda cloud API credential), only for AI_BACKEND=kimi and the CI canary.
KIMI_API_KEY=

# Absolute path of your clone of miska-voutilainen/junction26-messagepack-csharp (pnpm seed creates it).
SAMPLE_REPO_DIR=

# record: call the model and save each response to data/recordings/ (default)
# replay: read data/recordings/ only, fail on a miss
# live:   call the model without saving
AI_MODE=record
