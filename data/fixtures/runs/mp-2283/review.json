  "requirement": {
    "id": "MP-2283",
    "title": "Generator and analyzer crash with IndexOutOfRangeException on a closed generic struct from a referenced assembly",
    "intent": "A [MessagePackObject] type with a member of a closed generic value type from a referenced assembly builds cleanly and gets a generated resolver.",
    "functional": [
      {
        "id": "F1",
        "text": "The source generator does not throw IndexOutOfRangeException (CS8785) for a member whose type is a closed generic value type defined in a referenced assembly."
      },
      {
        "id": "F2",
        "text": "The compiling assembly gets a generated resolver that includes the affected [MessagePackObject] type."
      },
      {
        "id": "F3",
        "text": "The MsgPack00xMessagePackAnalyzer does not throw (AD0001) for the same member type."
      }
    ],
    "nonFunctional": [
      {
        "id": "N1",
        "text": "Generated output for types that were already supported does not change (inferred)"
      },
      {
        "id": "N2",
        "text": "A failure inside the generator or analyzer is reported as a diagnostic the user can see, not only as a build warning."
      }
    ],
    "derivedFrom": {
      "kind": "github-issue",
      "url": "https://github.com/MessagePack-CSharp/MessagePack-CSharp/issues/2283",
      "note": "Derived by the evidence lane from the upstream issue text on 2026-11-13; not Tieto's requirements set."
    }
  },
  "expectation": {
    "items": [
      {
        "requirementItemId": "F1",
        "expectedBehaviours": [
          "The source generator does not throw IndexOutOfRangeException (CS8785) for a member whose type is a closed generic value type defined in a referenced assembly."
        ],
        "likelyAreas": [
          "generator",
          "analyzer"
        ],
        "expectedTests": [
          "A test that exercises: The source generator does not throw IndexOutOfRangeException (CS8785) for a member whose type is a closed generic value type defined in a referenced assembly"
        ]
      },
      {
        "requirementItemId": "F2",
        "expectedBehaviours": [
          "The compiling assembly gets a generated resolver that includes the affected [MessagePackObject] type."
        ],
        "likelyAreas": [
          "generator",
          "analyzer"
        ],
        "expectedTests": [
          "A test that exercises: The compiling assembly gets a generated resolver that includes the affected [MessagePackObject] type"
        ]
      },
      {
        "requirementItemId": "F3",
        "expectedBehaviours": [
          "The MsgPack00xMessagePackAnalyzer does not throw (AD0001) for the same member type."
        ],
        "likelyAreas": [
          "generator",
          "analyzer"
        ],
        "expectedTests": [
          "A test that exercises: The MsgPack00xMessagePackAnalyzer does not throw (AD0001) for the same member type"
        ]
      }
    ]
  },
  "story": {
    "what": "Replaces three DeclaringSyntaxReferences[0] lookups in the type collector with null-safe lookups, wraps the analyzer's collector call so a failed lookup reports a diagnostic instead of crashing, and adds regression tests for the closed-generic case.",
    "why": "MP-2283 F1-F3: the generator silently produced no resolver for assemblies that use closed generic structs from a referenced assembly, which breaks trimmed and NativeAOT apps at runtime.",
    "touches": [
      {
        "symbol": "TypeCollector.GetObjectInfo",
        "file": "src/MessagePack.SourceGenerator/CodeAnalysis/TypeCollector.cs",
        "note": "Location lookup no longer assumes the type has syntax."
      },
      {
        "symbol": "MsgPack00xMessagePackAnalyzer.AnalyzeSymbol",
        "file": "src/MessagePack.SourceGenerator/Analyzers/MsgPack00xMessagePackAnalyzer.cs",
        "note": "Catches IndexOutOfRangeException and reports a diagnostic."
      },
      {
        "symbol": "FormatterTemplate (emitted Serialize signature)",
        "file": "src/MessagePack.SourceGenerator/Transforms/FormatterTemplate.cs",
        "note": "Renames the options parameter in emitted code; not asked for."
      }
    ]
  },
  "claims": [
    {
